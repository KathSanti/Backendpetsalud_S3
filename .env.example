# Copia este archivo como .env y reemplaza los valores. El .env nunca se sube a GitHub.
MYSQL_USERNAME=tu_usuario_mysql
MYSQL_PASSWORD=tu_password_mysql

# Clave para firmar los JWT (mínimo 32 bytes en Base64). Generar con: openssl rand -base64 32
JWT_SECRET_BASE64=reemplazar_por_clave_generada

# Contraseña de los usuarios de prueba creados al iniciar (mínimo 8 caracteres)
SEED_PASSWORD=reemplazar_por_password_de_prueba
